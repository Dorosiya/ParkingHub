<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.parking_hub.mapper.ReviewMapper">

    <resultMap id="ReviewResultMap" type="com.example.parking_hub.model.Review">
        <id property="id" column="id"/>
        <result property="prkCenterId" column="prk_center_id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="rating" column="rating"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertReview" parameterType="com.example.parking_hub.model.Review" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reviews (
            prk_center_id, 
            user_id, 
            username, 
            rating, 
            content, 
            created_at, 
            updated_at
        ) VALUES (
            #{prkCenterId}, 
            #{userId}, 
            #{username}, 
            #{rating}, 
            #{content}, 
            #{createdAt}, 
            #{updatedAt}
        )
    </insert>

    <select id="selectReviewsByParkingId" resultMap="ReviewResultMap">
        SELECT * FROM reviews 
        WHERE prk_center_id = #{prkCenterId}
        ORDER BY created_at DESC
    </select>

    <select id="selectReviewsByUserId" resultMap="ReviewResultMap">
        SELECT * FROM reviews 
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="selectReviewById" resultMap="ReviewResultMap">
        SELECT * FROM reviews 
        WHERE id = #{id}
    </select>

    <update id="updateReview" parameterType="com.example.parking_hub.model.Review">
        UPDATE reviews
        SET 
            rating = #{rating},
            content = #{content},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteReview">
        DELETE FROM reviews 
        WHERE id = #{id}
    </delete>

    <select id="countReviewsByParkingId" resultType="int">
        SELECT COUNT(*) FROM reviews 
        WHERE prk_center_id = #{prkCenterId}
    </select>

    <select id="selectAverageRatingByParkingId" resultType="double">
        SELECT COALESCE(AVG(rating), 0) FROM reviews 
        WHERE prk_center_id = #{prkCenterId}
    </select>

    <select id="selectReviewByParkingIdAndUserId" resultMap="ReviewResultMap">
        SELECT * FROM reviews 
        WHERE prk_center_id = #{prkCenterId} 
        AND user_id = #{userId}
    </select>
</mapper>