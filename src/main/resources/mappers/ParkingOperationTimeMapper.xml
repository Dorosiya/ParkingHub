<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.parking_hub.mapper.ParkingOperationTimeMapper">

    <resultMap id="ParkingOperationTimeResultMap" type="com.example.parking_hub.model.ParkingOperationTime">
        <id property="id" column="id"/>
        <result property="prkCenterId" column="prk_center_id"/>
        <result property="dayOfWeek" column="day_of_week"/>
        <result property="opertnStartTime" column="opertn_start_time"/>
        <result property="opertnEndTime" column="opertn_end_time"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectParkingOperationTimesByParkingId" resultMap="ParkingOperationTimeResultMap">
        SELECT * FROM PARKING_OPERATION_TIME WHERE prk_center_id = #{prkCenterId}
    </select>

    <select id="selectParkingOperationTimeById" resultMap="ParkingOperationTimeResultMap">
        SELECT * FROM PARKING_OPERATION_TIME WHERE id = #{id}
    </select>

    <select id="selectParkingOperationTimeByParkingIdAndDay" resultMap="ParkingOperationTimeResultMap">
        SELECT * FROM PARKING_OPERATION_TIME 
        WHERE prk_center_id = #{prkCenterId} AND day_of_week = #{dayOfWeek}
    </select>

    <select id="existsByParkingIdAndDayOfWeek" resultType="boolean">
        SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END 
        FROM PARKING_OPERATION_TIME 
        WHERE prk_center_id = #{prkCenterId} AND day_of_week = #{dayOfWeek}
    </select>

    <insert id="insertParkingOperationTime" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO PARKING_OPERATION_TIME (
            prk_center_id,
            day_of_week,
            opertn_start_time,
            opertn_end_time
        ) VALUES (
            #{prkCenterId},
            #{dayOfWeek},
            #{opertnStartTime},
            #{opertnEndTime}
        )
    </insert>

    <update id="updateParkingOperationTime">
        UPDATE PARKING_OPERATION_TIME
        SET day_of_week = #{dayOfWeek},
            opertn_start_time = #{opertnStartTime},
            opertn_end_time = #{opertnEndTime}
        WHERE id = #{id}
    </update>

    <insert id="insertOrUpdateParkingOperationTime">
        INSERT INTO PARKING_OPERATION_TIME (
            prk_center_id,
            day_of_week,
            opertn_start_time,
            opertn_end_time
        ) VALUES (
            #{prkCenterId},
            #{dayOfWeek},
            #{opertnStartTime},
            #{opertnEndTime}
        ) ON DUPLICATE KEY UPDATE
            opertn_start_time = VALUES(opertn_start_time),
            opertn_end_time = VALUES(opertn_end_time)
    </insert>

    <delete id="deleteParkingOperationTimeById">
        DELETE FROM PARKING_OPERATION_TIME WHERE id = #{id}
    </delete>

    <delete id="deleteParkingOperationTimesByParkingId">
        DELETE FROM PARKING_OPERATION_TIME WHERE prk_center_id = #{prkCenterId}
    </delete>

    <delete id="deleteAllParkingOperationTimes">
        DELETE FROM PARKING_OPERATION_TIME
    </delete>

</mapper> 